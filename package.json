{
  "name": "@asl-19/js-dom-utils",
  "version": "1.0.0",
  "description": "Shared JavaScript DOM utility functions for ASL19 projects",
  "type": "module",
  "author": {
    "name": "Grant Heaslip",
    "email": "grant@asl19.org",
    "url": "https://asl19.org/"
  },
  "license": "GPL-3.0-or-later",
  "repository": "ASL-19/js-dom-utils",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "sideEffects": false,
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "24.x",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig-dist.json",
    "build-lint-test": "run-s build lint-test",
    "dev-lint-test": "npm install --no-audit && npm run lint-test",
    "docs": "typedoc",
    "docs-check": "typedoc --out node_modules/.cache/docs-check && diff -r node_modules/.cache/docs-check docs || (echo \"docs/ is out of date: run npm run docs\" && exit 1)",
    "eslint-check": "eslint .",
    "eslint-fix": "eslint . --fix",
    "lint-test": "run-p -l docs-check tsc-check eslint-check prettier-check vitest-check publint-check",
    "mise-outdated": "mise outdated --local",
    "npm-outdated": "npm outdated || true",
    "outdated": "run-s -c -l mise-outdated npm-outdated pinact-outdated",
    "pinact-outdated": "pinact run --update --check --min-age 7 || true",
    "pinact-update": "pinact run --update --min-age 7",
    "prepublishOnly": "npm run build-lint-test",
    "prettier-check": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "publint-check": "publint",
    "test": "vitest",
    "tsc-check": "tsc --noEmit && tsc --noEmit --project tsconfig-dist.json",
    "vitest-check": "vitest run"
  },
  "devDependencies": {
    "@asl-19/eslint-config": "^0.11.0",
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "happy-dom": "^20.14.6",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "fsevents": false
  }
}
