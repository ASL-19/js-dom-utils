{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "incremental": true,
    "module": "preserve",
    "outDir": "dist",
    "strict": true,
    "target": "es2021",
    "types": [
      "node"
    ]
  },
  "include": [
    "*.js",
    "*.mjs",
    "*.ts",
    "src/**/*.ts*"
  ]
}
